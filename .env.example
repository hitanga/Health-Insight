# Firebase Configuration
# Obtain these from your Firebase Console under Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-health-blog-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-health-blog-app"
VITE_FIREBASE_STORAGE_BUCKET="your-health-blog-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Authorized Administrator Email
# Only this email address will be granted access to the private admin dashboard
VITE_ADMIN_EMAIL="admin@healthinsight.com"
