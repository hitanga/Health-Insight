rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read for blog posts so visitors can view published articles
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow public read for categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow public read for website settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public visitors can submit contact inquiries; authenticated admin can manage
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Public visitors can subscribe to the newsletter; authenticated admin can manage
    match /newsletterSubscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

  }
}
